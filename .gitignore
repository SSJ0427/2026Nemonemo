# Office 임시 파일
~$*
# 계획서 원본(구버전)은 docs/ 의 최신본으로 관리
/네모네모_프로젝트_계획서.docx

# 데이터 (용량 큼 - 공유 드라이브 사용)
data/raw/*
!data/raw/.gitkeep
data/videos/*
!data/videos/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
python/results/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
